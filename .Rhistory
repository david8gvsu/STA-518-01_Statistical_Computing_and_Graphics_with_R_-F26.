library(palmerpenguins)
library(tidyverse)
library(skimr)
library(knitr)
library(palmerpenguins)
library(tidyverse)
library(skimr)
library(knitr)
library(palmerpenguins)
library(tidyverse)
library(skimr)
library(knitr)
library(palmerpenguins)
library(tidyverse)
library(skimr)
library(knitr)
data(penguins, package = "palmerpenguins")
glimpse(penguins)
penguins |>
ggplot(aes(x=bill_depth_mm)   )
penguins |>
ggplot( aes(x=bill_depth_mm, y=bill_length_mm  ) )
penguins |>
ggplot( aes(x=bill_depth_mm, y=bill_length_mm) )+
geom_point()
penguins |>
ggplot(aes(x=bill_depth_mm,
y=bill_length_mm,
color= species))+
geom_point()
penguins |>
ggplot(aes(x=bill_depth_mm,
y=bill_length_mm,
color= species))+
geom_point()+
labs(title="Penguin bill length by bill depth",
subtitle = "Dimensions for Adelie, chinstrap, and Gentoo Penguins")
penguins |>
ggplot(aes(x=bill_depth_mm,
y=bill_length_mm,
color= species))+
geom_point()+
labs(title="Penguin bill length by bill depth",
subtitle = "Dimensions for Adelie, chinstrap, and Gentoo Penguins",
x="bill depth(mm)",
y="bill length(mm)" )
penguins |>
ggplot(aes(x=bill_depth_mm,
y=bill_length_mm,
color= species))+
geom_point()+
labs(title="Penguin bill length by bill depth",
subtitle = "Dimensions for Adelie, chinstrap, and Gentoo Penguins",
x="bill depth(mm)",
y="bill length(mm)",
color= "Species")
penguins |>
ggplot(aes(x=bill_depth_mm,
y=bill_length_mm,
color= species))+
geom_point()+
labs(title="Penguin bill length by bill depth",
subtitle = "Dimensions for Adelie, chinstrap, and Gentoo Penguins",
x="bill depth(mm)",
y="bill length(mm)",
color= "Species",
caption = "Source:Station LTER / polmernguins packag" )
penguins |>
ggplot(aes(x=bill_depth_mm,
y=bill_length_mm,
color= species))+
geom_point()+
labs(title="Penguin bill length by bill depth",
subtitle = "Dimensions for Adelie, chinstrap, and Gentoo Penguins",
x="bill_depth(mm)",
y="bill_length(mm)",
color="Species",
caption = "Source:Station LTER / polmernguins packag") +
scale_color_viridis_d()
ggplot(penguins,
aes(x = bill_depth_mm,
y = bill_length_mm,
size = body_mass_g,
alpha= flipper_length_mm)) +
geom_point()
ggplot(penguins,
aes(x = bill_depth_mm,
y = bill_length_mm)) +
geom_point(size = 2)
ggplot(penguins,
aes(x = bill_depth_mm,
y = bill_length_mm)) +
geom_point(size = 0.50)
skim(penguins)
penguins |>
ggplot(aes(x = body_mass_g,
color = species)) +
geom_histogram(fill = "white", position = "identity", alpha = 0.5, ) +
labs(
title = "Penguin body masses",
x = "Body Mass (g)",
y = "Frequency",
color = "Species",
caption = "Source: Palmer Station LTER / palmerpenguins package") +
scale_color_viridis_d()
penguins |>
ggplot(aes(x = body_mass_g,
color = species, fill = species)) +
geom_boxplot(alpha = 0.5) +
labs(
title = "Penguin body masses",
x = "Body Mass (g)",
y = NULL,
color = "Species",
fill = "Species",
caption = "Source: Palmer Station LTER / palmerpenguins package"
) +
scale_color_viridis_d() +
scale_fill_viridis_d() +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
