library(tidyverse)
# Load storms data set
data(storms)
storms |> ggplot(aes(x = pressure, y = wind)) +
geom_point()
#| label: storm-plot
#| message: false
#| out.width: "100%"
#| out.height: "300px"
#| fig.align: "center"
library(tidyverse)
# Load storms data set
data(storms)
storms |> ggplot(aes(x = pressure, y = wind)) +
geom_point()
xbar<-2
se<-1.3
#Largest sustained wind speeds recorded
storms_summary<- storms |>
group_by(name, year) |>
summarize(max_wind_knots =max(wind)) |>
ungroup() |>
slice_max(max_wind_knots, n=4)
library(knitr)
storms_summary |>
kable()
#| label: ‘tbl-a_table_name #label option must begin with "tbl" prefix
#| tbl-cap: ‘A custom table caption’
#| label: tbl-storms
#| tbl-cap: "Table made with kable()"
library(flextable)
storms_summary |>
flextable() |>
colformat_double(big.mark="", digits=0) |>
autofit()
library(gt)
storms_summary |>
gt()
# Displaying flextable with tron theme
#| label: storms_summary
storms_summary |>
flextable() |>
autofit() |>
theme_tron()
#| label: flextable-zebra-theme
library(flextable)
# Displaying flextable with a clean zebra theme
storms_summary |>
flextable() |>
autofit() |>
theme_zebra()
library(gtExtras)
#Displaying gt with dot_matrix
storms_summary |>
gt() |>
gt_theme_dot_matrix()
